# Importa a biblioteca Pandas, utilizada para ler e organizar tabelas
import pandas as pd

# Importa a biblioteca para criar gráficos
import matplotlib.pyplot as plt

# Importa a função que divide os dados em treinamento e teste
from sklearn.model_selection import train_test_split

# Importa a métrica que calcula a proporção total de acertos
from sklearn.metrics import accuracy_score

# Importa a função que apresenta as métricas de classificação
from sklearn.metrics import classification_report

# Importa a ferramenta que gera a matriz de confusão
from sklearn.metrics import ConfusionMatrixDisplay

# Importa o algoritmo KNN, que utiliza os vizinhos mais próximos
from sklearn.neighbors import KNeighborsClassifier

# Importa o algoritmo SVM, utilizado para separar classes
from sklearn.svm import SVC

# Importa o algoritmo Random Forest, que utiliza várias árvores de decisão
from sklearn.ensemble import RandomForestClassifier

# Importa as métricas de precisão, recall e F1-score
from sklearn.metrics import precision_score, recall_score, f1_score

# Lê o arquivo CSV que contém os dados dos documentos
dados = pd.read_csv("analise_documentos.csv")

# Mostra a quantidade total de documentos existentes no arquivo
print("Quantidade de documentos:", len(dados))

# Conta e mostra quantos documentos existem em cada classe
print("\nQuantidade por classe:")
print(dados["classe"].value_counts())

# Mostra os dois primeiros exemplos de cada classe
# Isso permite visualizar exemplos dos diferentes tipos de documentos
dados.groupby("classe", sort=False).head(2)

# Separa as características que serão utilizadas na classificação
# Essas colunas não serão usadas como características do modelo
caracteristicas = dados.drop(columns=[
    "classe",
    "arquivo",
    "texto_extraido",
    "pontuacao_palavras_chave",
    "tem_texto_rg",
    "tem_carteira_de_identidade"
])

# Define a coluna que contém a classe correta de cada documento
respostas = dados["classe"]

# Transforma valores booleanos em números
# True passa a ser 1 e False passa a ser 0
caracteristicas = caracteristicas.replace({
    True: 1,
    False: 0,
    "True": 1,
    "False": 0,
    "true": 1,
    "false": 0
})

# Transforma colunas categóricas em colunas numéricas
caracteristicas = pd.get_dummies(caracteristicas)

# Converte os valores para números
# Valores que não puderem ser convertidos viram NaN
caracteristicas = caracteristicas.apply(
    pd.to_numeric, errors="coerce"
)

# Remove colunas que não possuem nenhum valor válido
caracteristicas = caracteristicas.dropna(
    axis=1, how="all"
)

# Mostra quantas características e documentos serão utilizados
print("Características utilizadas:", caracteristicas.shape[1])
print("Quantidade de documentos:", caracteristicas.shape[0])

# Separa os dados em dois grupos:
# 80% para treinamento e 20% para teste
x_treino, x_teste, y_treino, y_teste = train_test_split(
    caracteristicas,
    respostas,
    test_size=0.2,
    random_state=42,
    stratify=respostas
)

# O stratify mantém aproximadamente a proporção de cada classe
# nos grupos de treinamento e teste.
# O random_state permite repetir a mesma divisão dos dados.

print("Documentos para treino:", len(x_treino))
print("Documentos para teste:", len(x_teste))

# Preenche os valores ausentes dos dados de treinamento
# utilizando a mediana de cada coluna
x_treino = x_treino.fillna(x_treino.median())

# Preenche os valores ausentes dos dados de teste
# utilizando as medianas calculadas nos dados de treinamento
x_teste = x_teste.fillna(x_treino.median())

# Cria o modelo KNN utilizando os 5 vizinhos mais próximos
modelo_knn = KNeighborsClassifier(n_neighbors=5)

# Treina o modelo com os dados de treinamento
modelo_knn.fit(x_treino, y_treino)

# Utiliza o modelo treinado para classificar os documentos de teste
previsao_knn = modelo_knn.predict(x_teste)

# Calcula e mostra a acurácia, que representa a proporção
# de documentos classificados corretamente
print("Acurácia:", accuracy_score(y_teste, previsao_knn))

# Mostra o relatório com as métricas de classificação:
# precisão, recall, F1-score e quantidade de documentos por classe
print("\nRelatório do KNN:")
print(classification_report(y_teste, previsao_knn, zero_division=0))

# Gera a matriz de confusão para comparar as classes reais
# com as classes previstas pelo modelo
# Os nomes das classes ficam na vertical para facilitar a leitura
ConfusionMatrixDisplay.from_predictions(
    y_teste, previsao_knn, xticks_rotation="vertical"
)

# Adiciona o título ao gráfico
plt.title("Matriz de Confusão - KNN")

# Exibe a matriz de confusão
plt.show()

# Importa a função que permite criar um modelo com várias etapas
from sklearn.pipeline import make_pipeline

# Importa a ferramenta que padroniza os valores das características
from sklearn.preprocessing import StandardScaler

# Importa o modelo SVM
from sklearn.svm import SVC

# Importa as métricas utilizadas para avaliar o modelo
from sklearn.metrics import accuracy_score, classification_report, ConfusionMatrixDisplay

# Importa a biblioteca para criar gráficos
import matplotlib.pyplot as plt


# Cria o modelo SVM com duas etapas:
# 1. Padronização dos valores das características
# 2. Classificação dos documentos utilizando o SVM
modelo_svm = make_pipeline(
    StandardScaler(),  # Coloca as características em escalas comparáveis
    SVC(
        kernel="rbf",           # Permite identificar relações não lineares
        C=1,                    # Define o controle sobre erros de classificação
        class_weight="balanced" # Dá mais peso às classes com menos exemplos
    )
)

# Treina o modelo com os documentos e suas respectivas classes
modelo_svm.fit(x_treino, y_treino)

# Utiliza o modelo treinado para prever as classes dos documentos de teste
previsao_svm = modelo_svm.predict(x_teste)

# Calcula a acurácia, ou seja, a proporção total de classificações corretas
print("Acurácia:", accuracy_score(y_teste, previsao_svm))

# Exibe o relatório com as métricas de classificação:
# Precisão: proporção das previsões de cada classe que estavam corretas
# Recall: proporção dos documentos de cada classe que foram identificados
# F1-Score: combina precisão e recall
print("\nRelatório do SVM:")
print(classification_report(
    y_teste, previsao_svm, zero_division=0
))

# Cria a matriz de confusão para comparar as classes reais
# com as classes previstas pelo modelo
# Os nomes das classes aparecem na vertical para facilitar a leitura
ConfusionMatrixDisplay.from_predictions(
    y_teste, previsao_svm, xticks_rotation="vertical"
)

# Define o título do gráfico
plt.title("Matriz de Confusão - SVM")

# Exibe a matriz de confusão
plt.show()

# Cria o modelo Random Forest com 100 árvores de decisão
modelo_floresta = RandomForestClassifier(
    n_estimators=100,  # Quantidade de árvores utilizadas pelo modelo
    random_state=42   # Garante resultados reproduzíveis na mesma configuração
)

# Treina o modelo utilizando os dados de treinamento
# O modelo aprende a relacionar as características aos tipos de documentos
modelo_floresta.fit(x_treino, y_treino)

# Utiliza o modelo treinado para classificar os documentos de teste
previsao_floresta = modelo_floresta.predict(x_teste)

# Calcula a acurácia, que representa a proporção total de acertos
print("Acurácia:", accuracy_score(y_teste, previsao_floresta))


print("\nRelatório do Random Forest:")
print(classification_report(
    y_teste, previsao_floresta, zero_division=0
))

# Gera a matriz de confusão para comparar as classes reais
# com as classes previstas pelo modelo
# Os nomes das classes aparecem na vertical
ConfusionMatrixDisplay.from_predictions(
    y_teste, previsao_floresta, xticks_rotation="vertical"
)

# Define o título do gráfico
plt.title("Matriz de Confusão - Random Forest")

# Exibe a matriz de confusão
plt.show()

# Cria uma tabela com os resultados dos três modelos
resultados = {
    # Nomes dos modelos avaliados
    "Modelo": ["KNN", "SVM", "Random Forest"],

    # Calcula a acurácia de cada modelo
    # Indica a proporção total de documentos classificados corretamente
    "Acurácia": [
        accuracy_score(y_teste, previsao_knn),
        accuracy_score(y_teste, previsao_svm),
        accuracy_score(y_teste, previsao_floresta)
    ],

    # Calcula a precisão média de cada modelo
    # average="macro" dá o mesmo peso para cada classe
    # zero_division=0 evita erros quando uma métrica não pode ser calculada
    "Precisão": [
        precision_score(y_teste, previsao_knn, average="macro", zero_division=0),
        precision_score(y_teste, previsao_svm, average="macro", zero_division=0),
        precision_score(y_teste, previsao_floresta, average="macro", zero_division=0)
    ],

    # Calcula o recall médio de cada modelo
    # Mostra a capacidade de identificar corretamente os documentos de cada classe
    "Recall": [
        recall_score(y_teste, previsao_knn, average="macro", zero_division=0),
        recall_score(y_teste, previsao_svm, average="macro", zero_division=0),
        recall_score(y_teste, previsao_floresta, average="macro", zero_division=0)
    ],

    # Calcula o F1-Score médio de cada modelo
    # Combina precisão e recall em uma única métrica
    "F1-Score": [
        f1_score(y_teste, previsao_knn, average="macro", zero_division=0),
        f1_score(y_teste, previsao_svm, average="macro", zero_division=0),
        f1_score(y_teste, previsao_floresta, average="macro", zero_division=0)
    ]
}

# Transforma os resultados em uma tabela do Pandas
comparacao = pd.DataFrame(resultados)

# Ordena os modelos pelo F1-Score, do maior para o menor
comparacao = comparacao.sort_values(
    by="F1-Score", ascending=False
)

# Exibe a tabela comparativa
comparacao
